{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jagtesh/superlemon/blob/main/packaging/release-acceptance.schema.json",
  "title": "Superlemon candidate release acceptance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "tester",
    "evidence_root",
    "performance",
    "checks",
    "decision"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "commit_sha",
        "artifact_filename",
        "archive_sha256",
        "architecture",
        "packaged_neovim_version"
      ],
      "properties": {
        "tag": { "type": "string", "pattern": "^v[^/]+$" },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact_filename": { "type": "string", "minLength": 1 },
        "archive_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "architecture": { "const": "arm64" },
        "packaged_neovim_version": { "type": "string", "minLength": 1 }
      }
    },
    "tester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tested_at",
        "macos_version_build",
        "hardware",
        "display",
        "input_sources"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tested_at": { "type": "string", "format": "date-time" },
        "macos_version_build": { "type": "string", "minLength": 1 },
        "hardware": { "type": "string", "minLength": 1 },
        "display": { "type": "string", "minLength": 1 },
        "input_sources": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_root": { "type": "string", "minLength": 1 },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redraw_search", "filesystem_stress"],
      "properties": {
        "redraw_search": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_seconds",
            "sample_count",
            "rss_growth_budget_mib",
            "observed_rss_growth_mib",
            "unresponsive_budget_ms",
            "observed_max_unresponsive_ms"
          ],
          "properties": {
            "duration_seconds": { "type": "number", "minimum": 300 },
            "sample_count": { "type": "integer", "minimum": 7 },
            "rss_growth_budget_mib": { "type": "number", "exclusiveMinimum": 0 },
            "observed_rss_growth_mib": { "type": "number", "minimum": 0 },
            "unresponsive_budget_ms": { "type": "number", "exclusiveMinimum": 0 },
            "observed_max_unresponsive_ms": { "type": "number", "minimum": 0 }
          }
        },
        "filesystem_stress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file_count",
            "mutation_count",
            "stall_budget_ms",
            "observed_max_stall_ms"
          ],
          "properties": {
            "file_count": { "type": "integer", "minimum": 50000 },
            "mutation_count": { "type": "integer", "minimum": 500 },
            "stall_budget_ms": { "type": "number", "exclusiveMinimum": 0 },
            "observed_max_stall_ms": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposable_workspace",
        "input_sources_installed",
        "performance_budgets_recorded",
        "dead_key",
        "emoji",
        "japanese_romaji",
        "simplified_chinese_pinyin",
        "korean_2_set",
        "voiceover",
        "five_minute_redraw_search",
        "main_thread_filesystem_stress",
        "open_edit_save_reopen",
        "quit_modified_buffer_matrix",
        "sidebar_operations_and_error_recovery",
        "sidebar_layout_state_preserved",
        "quick_open_and_editor_chrome",
        "reduce_motion_and_appearance"
      ],
      "properties": {
        "disposable_workspace": { "$ref": "#/$defs/check" },
        "input_sources_installed": { "$ref": "#/$defs/check" },
        "performance_budgets_recorded": { "$ref": "#/$defs/check" },
        "dead_key": { "$ref": "#/$defs/check" },
        "emoji": { "$ref": "#/$defs/check" },
        "japanese_romaji": { "$ref": "#/$defs/check" },
        "simplified_chinese_pinyin": { "$ref": "#/$defs/check" },
        "korean_2_set": { "$ref": "#/$defs/check" },
        "voiceover": { "$ref": "#/$defs/check" },
        "five_minute_redraw_search": { "$ref": "#/$defs/check" },
        "main_thread_filesystem_stress": { "$ref": "#/$defs/check" },
        "open_edit_save_reopen": { "$ref": "#/$defs/check" },
        "quit_modified_buffer_matrix": { "$ref": "#/$defs/check" },
        "sidebar_operations_and_error_recovery": { "$ref": "#/$defs/check" },
        "sidebar_layout_state_preserved": { "$ref": "#/$defs/check" },
        "quick_open_and_editor_chrome": { "$ref": "#/$defs/check" },
        "reduce_motion_and_appearance": { "$ref": "#/$defs/check" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "release_owner",
        "signed_off_at",
        "evidence",
        "blocking_issues"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "release_owner": { "type": "string", "minLength": 1 },
        "signed_off_at": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "blocking_issues": { "type": "array", "maxItems": 0 }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["PASS", "FAIL", "BLOCKED", "NOT RUN"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "notes": { "type": "string" }
      }
    }
  }
}
